# Android 透明模式示例。
[proxy]
mode = "transparent"
listen = ["127.0.0.1:6045"]
upstream = "http://127.0.0.1:9910"
udp_upstream = "socks5://127.0.0.1:9909"
max_connections = 4096
idle_timeout_secs = 300

[routing]
exclude_ports = [53]

[udp]
enabled = true
default = "proxy"
reject_ports = [443]

[rules]
file = "/data/adb/routeproxy/rules.toml"
reload = true

[logging]
file = "/data/adb/routeproxy/logs/routeproxy.log"
level = "info"
max_size_mb = 5
keep = 3
