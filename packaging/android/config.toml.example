[proxy]
mode = "transparent"
listen = ["127.0.0.1:6045"]
upstream = "127.0.0.1:9910"
# 同时活跃 TCP 连接上限；按设备 fd/内存预算调整。
max_connections = 4096
# 双向连接无数据多久后回收；避免半关闭连接长期占用槽位。
idle_timeout_secs = 300

[rules]
file = "/data/adb/routeproxy/rules.toml"
reload = true

[logging]
file = "/data/adb/routeproxy/logs/routeproxy.log"
level = "info"
max_size_mb = 5
keep = 3
